{
  "name": "stream-dock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && pnpm check:css && pnpm check:version && pnpm check:effect-contract",
    "test:watch": "vitest",
    "check:css": "node scripts/check-css-guards.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:effect-contract": "node scripts/check-effect-template-contract.mjs",
    "build:sidecar": "pnpm --filter @stream-dock/comment-sidecar build:sea",
    "check:sidecar": "node ../comment-sidecar/scripts/check-fresh.mjs",
    "gen:bindings": "cd src-tauri && cargo test export_bindings",
    "check:bindings": "pnpm gen:bindings && git diff --exit-code -- src/features/tools/bindings src/features/presets/bindings src/features/logs/bindings src/features/comment-viewer/bindings src/features/viewer-memory/bindings src/features/app-update/bindings src/features/obs-effects/bindings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
