{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamDock",
  "version": "0.1.0",
  "identifier": "com.tetsuya.stream-dock",
  "build": {
    "beforeDevCommand": "pnpm check:sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm check:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamDock",
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 28 },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/comment-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/satoh23/StreamDock-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNDAxMTkxQ0YzQzI4QjcKUldTM0tEelBrUkZBWXlqRDIvZ3FEODNqVVNVSysvZCtjdm1pWG5QeVNLYmtOT3lpZXNoQWhxblEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
